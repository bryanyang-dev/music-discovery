          "value": "\"track_streaming_matches\".\"provider\" ~ '^[a-z][a-z0-9_]*$'"
        },
        "streaming_matches_status_valid": {
          "name": "streaming_matches_status_valid",
          "value": "\"track_streaming_matches\".\"match_status\" IN ('pending', 'matched', 'not_found', 'ambiguous')"
        },
        "streaming_matches_method_valid": {
          "name": "streaming_matches_method_valid",
          "value": "\"track_streaming_matches\".\"match_method\" IS NULL OR \"track_streaming_matches\".\"match_method\" IN ('review_link', 'search', 'manual')"
        },
        "streaming_matches_recording_state_valid": {
          "name": "streaming_matches_recording_state_valid",
          "value": "(\n    \"track_streaming_matches\".\"match_status\" = 'matched'\n    AND \"track_streaming_matches\".\"provider_track_id\" IS NOT NULL AND length(trim(\"track_streaming_matches\".\"provider_track_id\")) > 0\n    AND \"track_streaming_matches\".\"provider_url\" IS NOT NULL AND length(trim(\"track_streaming_matches\".\"provider_url\")) > 0\n    AND \"track_streaming_matches\".\"match_method\" IS NOT NULL AND \"track_streaming_matches\".\"matched_at\" IS NOT NULL\n  ) OR (\n    \"track_streaming_matches\".\"match_status\" <> 'matched'\n    AND \"track_streaming_matches\".\"provider_track_id\" IS NULL AND \"track_streaming_matches\".\"provider_url\" IS NULL\n    AND \"track_streaming_matches\".\"provider_title\" IS NULL AND \"track_streaming_matches\".\"provider_artists\" IS NULL\n    AND \"track_streaming_matches\".\"uploader_name\" IS NULL AND \"track_streaming_matches\".\"uploader_url\" IS NULL\n    AND \"track_streaming_matches\".\"match_method\" IS NULL AND \"track_streaming_matches\".\"matched_at\" IS NULL\n  )"
        }
      },
