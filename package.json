{
  "name": "music-discovery",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "db:migrate:local": "DATABASE_MIGRATION_ALLOW_LOCAL_NO_TLS=1 node --env-file=.env.local --import tsx node_modules/drizzle-kit/bin.cjs migrate --config=drizzle.migrate.config.ts",
    "test:db:local": "node --env-file=.env.local --import tsx --test packages/db/test/upsert.test.ts",
    "upload:lambda": "bash scripts/upload-lambda.sh",
    "test:upload": "node --test scripts/test/upload-lambda.test.mjs",
    "test": "node --import tsx --test packages/shared/test/*.test.ts packages/rss/test/*.test.ts packages/db/test/merge.test.ts packages/db/test/policy.test.ts packages/db/test/schema.test.ts packages/db/test/deadline.test.ts packages/db/test/database-logging.test.ts packages/db/test/errors.test.ts packages/db/test/connection.test.ts packages/db/test/migration-config.test.ts apps/ingestion/test/*.test.ts && node --test infra/test/*.test.mjs scripts/test/*.test.mjs",
    "test:db": "node --import tsx --test packages/db/test/upsert.test.ts",
    "test:bundle": "pnpm build:lambda && node --test apps/ingestion/test/bundle.test.mjs",
    "sources:add": "node --env-file-if-exists=.env --import tsx apps/ingestion/src/add-source.cli.ts",
    "ingest": "node --env-file-if-exists=.env --import tsx apps/ingestion/src/local.ts",
    "ingest:preview": "node --env-file-if-exists=.env --import tsx apps/ingestion/src/local.ts --preview",
    "ingest:fixture": "node --import tsx apps/ingestion/src/local.ts --fixture",
    "db:generate": "node --import tsx node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx node_modules/drizzle-kit/bin.cjs migrate --config=drizzle.migrate.config.ts",
    "build:lambda": "esbuild apps/ingestion/src/handler.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/ingestion/index.cjs"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.0.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "^0.25.0",
    "supabase": "^3.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
