DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
DATABASE_MIGRATION_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres


# Spotify app credentials: used by `pnpm match` and the track matcher Lambda (set
# manually in its AWS console environment). `pnpm api:dev` serves the client ID to
# the browser for sign-in; the secret never leaves the server.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US
